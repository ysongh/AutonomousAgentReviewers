PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY_HERE
RPC_URL=https://evmrpc-testnet.0g.ai
INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
ANTHROPIC_API_KEY=sk-ant-...
GITHUB_TOKEN=

# Demo Judge (Phase 2):
#   FILECOIN_PRIVATE_KEY — Calibration-testnet wallet that holds the demo video on
#     Filecoin Warm Storage. Must already have a USDFC deposit + Warm Storage
#     operator approval (the bootstrap-filecoin spike wallet does). Only intake uses it.
#   OPENAI_API_KEY — used by judge-demo for Whisper (whisper-1) transcription.
#   FILECOIN_EXCLUDE_PROVIDER_IDS — optional, comma-separated Warm Storage
#     provider ids to avoid (copies:1 has no provider failover). Leave unset.
FILECOIN_PRIVATE_KEY=0xYOUR_CALIBRATION_PRIVATE_KEY_HERE
OPENAI_API_KEY=sk-...
# FILECOIN_EXCLUDE_PROVIDER_IDS=

# Per-agent wallets live in .env.agents (NOT this file). Generate with:
#   node scripts/generate-agent-wallets.js
# That script writes:
#   INTAKE_PRIVATE_KEY=0x...
#   INTAKE_ADDRESS=0x...
#   JUDGE_TECHNICAL_PRIVATE_KEY=0x...
#   JUDGE_TECHNICAL_ADDRESS=0x...
#   JUDGE_ORIGINALITY_PRIVATE_KEY=0x...
#   JUDGE_ORIGINALITY_ADDRESS=0x...
#   JUDGE_SKEPTIC_PRIVATE_KEY=0x...
#   JUDGE_SKEPTIC_ADDRESS=0x...
# Fund each address with ~0.05 0G from https://faucet.0g.ai before starting agents.
# The legacy PRIVATE_KEY above is kept for bootstrap/ scripts only; agents use .env.agents.
