# Filecoin Calibration testnet spike — copy to .env and fill in.
# .env is gitignored. NEVER commit a real key.

# Fresh keypair generated by gen-wallet.js (do NOT reuse any AAR key).
FILECOIN_PRIVATE_KEY=0x...

# Optional RPC override. If unset, the SDK uses the Calibration default
# baked into the `calibration` chain object:
#   https://api.calibration.node.glif.io/rpc/v1
# Chain is fixed to Calibration (chainId 314159) in code.
# FILECOIN_RPC_URL=https://api.calibration.node.glif.io/rpc/v1
